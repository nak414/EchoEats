        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class Vendor {\n        -vendorId: String\n        -businessName: String\n        -email: String\n        -passwordHash: String\n        -address: String\n        +createListing(name: String, quantity: int, initialPrice: double, minimumPrice: double) FoodListing\n        +updateListing(listingId: String, quantity: int) void\n        +viewReservations() List~Reservation~\n        +confirmPickup(pickupCode: String) boolean\n    }\n\n    class Consumer {\n        -consumerId: String\n        -name: String\n        -email: String\n        -passwordHash: String\n        +searchListings(keyword: String) List~FoodListing~\n        +reserveFood(listing: FoodListing, quantity: int) Reservation\n        +viewReservations() List~Reservation~\n    }\n\n    class FoodListing {\n        -listingId: String\n        -name: String\n        -description: String\n        -photoUrl: String\n        -dietaryTags: List~String~\n        -quantity: int\n        -initialPrice: double\n        -minimumPrice: double\n        -currentPrice: double\n        -expiryTime: DateTime\n        -pickupDeadline: DateTime\n        -status: String\n        +isAvailable(quantity: int) boolean\n        +reserveQuantity(quantity: int) boolean\n        +releaseQuantity(quantity: int) void\n        +updateQuantity(amount: int) void\n        +deactivate() void\n    }\n\n    class Reservation {\n        -reservationId: String\n        -quantity: int\n        -lockedPrice: double\n        -holdExpiresAt: DateTime\n        -status: String\n        +createHold() void\n        +isActive() boolean\n        +getTotalPrice() double\n        +checkout() Order\n        +expire() void\n        +cancel() void\n    }\n\n    class Order {\n        -orderId: String\n        -totalPrice: double\n        -pickupCode: String\n        -status: String\n        +confirm() void\n        -generatePickupCode() String\n        +markCollected() void\n    }\n\n    class PricingRule {\n        -pricingType: String\n        -demandFactor: double\n        -updateIntervalMinutes: int\n        +calculatePrice(listing: FoodListing) double\n        -applyDemandAdjustment(price: double) double\n        -applyMinimumPrice(price: double, minimumPrice: double) double\n    }\n\n    class PricingStrategy {\n        &lt;&lt;interface&gt;&gt;\n        +calculate(initialPrice: double, timeRemaining: double) double\n    }\n    class LinearPricing {\n        +calculate(initialPrice: double, timeRemaining: double) double\n    }\n    class ExponentialPricing {\n        +calculate(initialPrice: double, timeRemaining: double) double\n    }\n    class SteppedPricing {\n        +calculate(initialPrice: double, timeRemaining: double) double\n    }\n\n    class FoodListingRepository {\n        &lt;&lt;interface&gt;&gt;\n        +findById(listingId: String) FoodListing\n        +save(listing: FoodListing) void\n    }\n    class ReservationRepository {\n        &lt;&lt;interface&gt;&gt;\n        +findById(reservationId: String) Reservation\n        +save(reservation: Reservation) void\n    }\n    class OrderRepository {\n        &lt;&lt;interface&gt;&gt;\n        +findByPickupCode(pickupCode: String) Order\n        +save(order: Order) void\n    }\n\n    Vendor \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FoodListing : creates\n    Consumer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Reservation : makes\n    Reservation \&quot;0..*\&quot; --&gt; \&quot;1\&quot; FoodListing : references\n    Reservation \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Order : results in\n    FoodListing \&quot;0..*\&quot; --&gt; \&quot;1\&quot; PricingRule : uses\n\n    PricingRule ..&gt; PricingStrategy : uses\n    PricingStrategy &lt;|.. LinearPricing\n    PricingStrategy &lt;|.. ExponentialPricing\n    PricingStrategy &lt;|.. SteppedPricing\n\n    FoodListingRepository ..&gt; FoodListing : stores\n    ReservationRepository ..&gt; Reservation : stores\n    OrderRepository ..&gt; Order : stores\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="7VIEhA5zHDPj6wTeA96N-8">
