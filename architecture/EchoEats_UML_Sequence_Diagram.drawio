  <diagram name="Page-1" id="r0D8ge6oLA4yFE7xqTwu">
    <mxGraphModel dx="3064" dy="1816" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="light-dark(#FFFFFF,#121212)" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n    autonumber\n    actor C as Consumer\n    participant UI as Consumer Interface\n    box rgb(245, 247, 250) EchoEats Backend - Modular Monolith\n        participant RM as Reservation Module\n        participant LP as Listing &amp; Pricing Module\n        participant DB as Database\n        participant CO as Checkout / Orders Module\n    end\n\n    C-&gt;&gt;UI: Select food listing and quantity\n    UI-&gt;&gt;RM: Request reservation\n    activate RM\n    RM-&gt;&gt;LP: Check listing and availability\n    activate LP\n    LP-&gt;&gt;DB: Get listing, stock and price\n    DB--&gt;&gt;LP: Listing details\n    LP--&gt;&gt;RM: Validity, stock and current price\n    deactivate LP\n\n    alt Listing invalid or insufficient stock\n        RM--&gt;&gt;UI: Reject reservation\n        Note over RM,DB: Stock remains unchanged\n        UI--&gt;&gt;C: Show unavailable or insufficient stock\n    else Listing valid and sufficient stock\n        RM-&gt;&gt;DB: Atomically create 15-minute hold, lock price and reserve stock\n        DB--&gt;&gt;RM: Hold ID, expiry time and locked price\n        Note over RM,DB: Reserved stock unavailable to others\n        RM--&gt;&gt;UI: Reservation details and countdown\n        UI--&gt;&gt;C: Display hold and 15-minute timer\n\n        alt Checkout before hold expires\n            C-&gt;&gt;UI: Confirm simulated checkout\n            UI-&gt;&gt;CO: Submit checkout with hold ID\n            activate CO\n            CO-&gt;&gt;DB: Verify active hold and confirm order\n            DB--&gt;&gt;CO: Order confirmed and unique pickup code\n            CO--&gt;&gt;UI: Confirmation and pickup code\n            deactivate CO\n            UI--&gt;&gt;C: Display order and pickup code\n        else Reservation expires before checkout\n            RM-&gt;&gt;DB: Expire unpaid hold and release eligible stock\n            DB--&gt;&gt;RM: Hold expired and stock updated\n            RM--&gt;&gt;UI: Reservation expired\n            UI--&gt;&gt;C: Show expiry and request new reservation\n        end\n    end\n    deactivate RM\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="bBO5ClgY3ahAfnfvaByi-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
