      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n    autonumber\n    actor C as Consumer\n    participant UI as Consumer Interface\n    participant RS as Reservation Service\n    participant LP as Listing/Pricing Service\n    participant DB as Database\n    participant CO as Checkout/Order Service\n\n    C-&gt;&gt;UI: Select food listing and quantity\n    UI-&gt;&gt;+RS: Request reservation\n    RS-&gt;&gt;+LP: Check listing and availability\n    LP-&gt;&gt;+DB: Get listing, stock and price\n    DB--&gt;&gt;-LP: Listing details\n    LP--&gt;&gt;-RS: Validity, stock and current price\n\n    alt Listing invalid or insufficient stock\n        RS--&gt;&gt;UI: Reject reservation\n        Note over RS,DB: Stock remains unchanged\n        UI--&gt;&gt;C: Show unavailable or insufficient stock\n    else Listing valid and sufficient stock\n        RS-&gt;&gt;+DB: Atomically create 15-minute hold, lock price and reserve stock\n        DB--&gt;&gt;-RS: Hold ID, expiry time and locked price\n        Note over RS,DB: Reserved stock unavailable to others\n        RS--&gt;&gt;UI: Reservation details and countdown\n        UI--&gt;&gt;C: Display hold and 15-minute timer\n\n        alt Checkout before hold expires\n            C-&gt;&gt;UI: Confirm simulated checkout\n            UI-&gt;&gt;+CO: Submit checkout with hold ID\n            CO-&gt;&gt;+DB: Verify active hold and confirm order\n            DB--&gt;&gt;-CO: Order confirmed and unique pickup code\n            CO--&gt;&gt;-UI: Confirmation and pickup code\n            UI--&gt;&gt;C: Display order and pickup code\n        else Reservation expires before checkout\n            RS-&gt;&gt;+DB: Expire unpaid hold and release eligible stock\n            DB--&gt;&gt;-RS: Hold expired and stock updated\n            RS--&gt;&gt;UI: Reservation expired\n            UI--&gt;&gt;C: Show expiry and request new reservation\n        end\n    end\n    deactivate RS\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="7VmnCGwSbg29ieZbXpwn-1">
